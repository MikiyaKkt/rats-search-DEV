#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_PATCH@,@VERSION_BUILD@
 PRODUCTVERSION @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_PATCH@,@VERSION_BUILD@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@RATSSEARCH_PRODUCT_NAME@"
            VALUE "FileVersion", "@VERSION_STRING@"
            VALUE "OriginalFilename", "RatsSearch.exe"
            VALUE "ProductName", "@RATSSEARCH_PRODUCT_NAME@"
            VALUE "ProductVersion", "@VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
