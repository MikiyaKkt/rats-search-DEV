+CreateResult Client::create_torrent(const TorrentInfo& info, const std::string& save_path, CreateOptions options) {
+    return run_on_reactor([&]() -> CreateResult {
+        if (!info.is_valid() || !info.has_metadata()) return {false, {}, "invalidMetadata"};
+        if (torrents_.count(info.info_hash())) return {false, info.info_hash(), "alreadyExists"};
+        auto* torrent = add_torrent_impl(info, save_path, StartMode::Inactive);
+        if (!torrent) return {false, info.info_hash(), "engineRejected"};
+        if (options.load_resume) torrent->try_load_resume_data();
+        if (options.verify_existing) torrent->verify_resume_on_start();
+        torrent->set_content_allowed(options.mode == StartMode::Automatic);
+        if (options.mode != StartMode::Inactive) torrent->start();
+        return {true, info.info_hash(), {}};
+    });
+}
+
+CreateResult Client::create_magnet(const std::string& uri, const std::string& save_path, CreateOptions options) {
+    return run_on_reactor([&]() -> CreateResult {
+        const auto info = TorrentInfo::from_magnet(uri);
+        if (!info || !info->is_valid()) return {false, {}, "invalidMagnet"};
+        if (torrents_.count(info->info_hash())) return {false, info->info_hash(), "alreadyExists"};
+        auto* torrent = add_magnet_impl(uri, save_path, options.load_resume, options.mode, options.verify_existing);
+        return {torrent != nullptr, info->info_hash(), torrent ? "" : "engineRejected"};
+    });
+}
+
+bool Client::start_metadata(const InfoHash& hash) {
+    return run_on_reactor([&] {
+        const auto i = torrents_.find(hash);
+        if (i == torrents_.end() || i->second->last_error()) return false;
+        i->second->start_metadata_only();
+        return true;
+    });
+}
+
+bool Client::start_content(const InfoHash& hash) {
+    return run_on_reactor([&] {
+        const auto i = torrents_.find(hash);
+        return i != torrents_.end() && i->second->start_content();
+    });
+}
