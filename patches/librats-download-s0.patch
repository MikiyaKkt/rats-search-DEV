diff --git a/src/librats/bittorrent/download_error.h b/src/librats/bittorrent/download_error.h
new file mode 100644
index 0000000..d182500
--- /dev/null
+++ b/src/librats/bittorrent/download_error.h
@@ -0,0 +1,37 @@
+#pragma once
+
+#include <cerrno>
+#include <string>
+
+namespace librats::bittorrent {
+
+// Values cross the disk-worker/reactor boundary by value; never read errno on
+// the reactor to diagnose an operation performed by another thread.
+struct DiskError {
+    std::string code;
+    std::string operation;
+    std::string path;
+    int system_code = 0;
+    bool retryable = false;
+    explicit operator bool() const noexcept { return !code.empty(); }
+};
+
+inline DiskError classify_fs_error(int code, std::string operation, std::string path) {
+    DiskError error;
+    error.system_code = code ? code : EIO;
+    error.operation = std::move(operation);
+    error.path = std::move(path);
+    switch (error.system_code) {
+    case ENOSPC: error.code = "diskFull"; break;
+    case EACCES: case EPERM: error.code = "permissionDenied"; break;
+    case EINVAL: case EILSEQ: case ENAMETOOLONG: case ENOTDIR:
+        error.code = "invalidPath"; break;
+    case ENOENT: error.code = "missingData"; break;
+    case EAGAIN: case EINTR: case EBUSY:
+        error.code = "temporaryIo"; error.retryable = true; break;
+    default: error.code = "ioError"; break;
+    }
+    return error;
+}
+
+} // namespace librats::bittorrent
