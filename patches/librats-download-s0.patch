+void Torrent::set_content_allowed(bool allowed) {
+    content_allowed_ = allowed;
+    if (!allowed && running_ && has_metadata_ && state_ != State::Checking && !last_error_) {
+        pause(); // drops outstanding requests before returning
+        state_ = State::Waiting;
