+bool Torrent::start_content() {
+    if (last_error_) return false; // ordinary resume must not clear an I/O fault
+    content_allowed_ = true;
+    if (!running_) start();
+    if (paused_) resume();
+    if (state_ == State::Waiting) state_ = is_complete() ? State::Seeding : State::Downloading;
+    for (auto* peer : std::vector<PeerConnection*>(peers_)) if (alive(peer) && picker_) update_interest(*peer);
