+#pragma once
+#include "librats/bittorrent/torrent_info.h"
+#include "librats/bittorrent/file_selection.h"
+#include <string>
+
+namespace librats::bittorrent {
+// Called only by disk workers. Selection changes run behind an exclusive queue
+// barrier; normal reads/writes never race mapping replacement.
+class BoundaryStore {
+public:
+    BoundaryStore(const TorrentInfo&,std::string savePath);
+    bool load_manifest();
+    bool apply_selection_change(const std::vector<int>& priorities,std::uint64_t revision);
+    const std::vector<int>& priorities() const {return priorities_;}
+    std::uint64_t revision() const {return revision_;}
+    const std::string& error() const {return error_;}
+    std::string path(std::uint32_t piece,const FileSlice&) const;
+    std::uint64_t offset(std::uint32_t piece,const FileSlice&) const;
+    bool ensure_part(std::uint32_t piece,const FileSlice&);
+    std::string read_path(std::uint32_t piece,const FileSlice&,std::uint64_t& offset) const;
+private:
+    std::string part_path(std::uint32_t piece,std::size_t file) const;
+    FileSlice full_slice(std::uint32_t piece,std::size_t file) const;
+    bool save_manifest(const std::vector<int>&,std::uint64_t);
+    bool materialize(std::size_t file,std::vector<std::string>& created);
+    FileStorage files_;
+    std::string save_,root_,hash_,error_;
+    std::vector<int> priorities_;
+    std::uint64_t revision_=0;
+};
+}
