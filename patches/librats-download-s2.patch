new file mode 100644
index 0000000..e6d9132
--- /dev/null
+++ b/src/librats/bittorrent/boundary_store.cpp
@@ -0,0 +1,96 @@
+#include "librats/bittorrent/boundary_store.h"
+#include "librats/bittorrent/bencode.h"
+#include "librats/util/fs.h"
+#include <filesystem>
+#include <stdexcept>
+
+namespace librats::bittorrent {
+BoundaryStore::BoundaryStore(const TorrentInfo& info,std::string path)
+    :files_(info.files()),save_(std::move(path)),hash_(info.info_hash_hex()),priorities_(info.num_files(),1) {
+    root_=combine_paths(combine_paths(save_,".parts"),hash_);
+    load_manifest();
+}
+bool BoundaryStore::load_manifest() {
+    const auto path=combine_paths(root_,"manifest");
+    if(!file_exists(path)) {error_.clear();return true;}
+    std::size_t size=0;auto* raw=read_file_binary(path.c_str(),&size);
+    if(!raw) {error_="Cannot read boundary manifest";return false;}
+    Bytes data(static_cast<std::uint8_t*>(raw),static_cast<std::uint8_t*>(raw)+size);free_file_buffer(raw);
+    try {
+        auto doc=BencodeDecoder::decode(data.data(),data.size());
+        const auto* h=doc.find("hash");const auto* version=doc.find("version");
+        const auto* p=doc.find("priorities");const auto* r=doc.find("revision");
+        if(!h || !h->is_string() || h->as_string()!=hash_ || !version || !version->is_integer() || version->as_integer()!=1
+            || !p || !p->is_string() || p->as_string().size()!=priorities_.size()
+            || !r || !r->is_integer() || r->as_integer()<0 || r->as_integer()>9007199254740991LL) throw std::runtime_error("Invalid boundary manifest");
+        std::vector<int> next;for(unsigned char value:p->as_string()) next.push_back(value);
+        if(!FileSelection::validate(files_,next).empty()) throw std::runtime_error("Invalid boundary priorities");
+        priorities_=std::move(next);revision_=r->as_integer();error_.clear();return true;
+    } catch(...) {error_="Boundary manifest is corrupt or does not match metadata";return false;}
+}
+std::string BoundaryStore::part_path(std::uint32_t piece,std::size_t file) const {
+    return combine_paths(root_,std::to_string(piece)+"-"+std::to_string(file)+".part");
+}
+FileSlice BoundaryStore::full_slice(std::uint32_t piece,std::size_t file) const {
+    for(const auto& s:files_.map_block(piece,0,files_.piece_size(piece))) if(s.file_index==file) return s;
+    return {};
+}
+std::string BoundaryStore::path(std::uint32_t piece,const FileSlice& s) const {
+    return priorities_[s.file_index]?combine_paths(save_,files_.file_at(s.file_index).path):part_path(piece,s.file_index);
+}
+std::uint64_t BoundaryStore::offset(std::uint32_t piece,const FileSlice& s) const {
+    return priorities_[s.file_index]?s.offset:s.offset-full_slice(piece,s.file_index).offset;
+}
+std::string BoundaryStore::read_path(std::uint32_t piece,const FileSlice& s,std::uint64_t& at) const {
+    at=offset(piece,s);auto result=path(piece,s);
+    // A deselected pre-existing final file is preserved and remains readable.
+    if(!priorities_[s.file_index] && !file_exists(result)) {at=s.offset;return combine_paths(save_,files_.file_at(s.file_index).path);}
+    return result;
+}
+bool BoundaryStore::ensure_part(std::uint32_t piece,const FileSlice& s) {
+    auto target=part_path(piece,s.file_index);
+    if(file_exists(target)) return true;
+    return create_directories(root_.c_str()) && create_file_with_size(target,full_slice(piece,s.file_index).size);
+}
+bool BoundaryStore::save_manifest(const std::vector<int>& p,std::uint64_t revision) {
+    if(!create_directories(root_.c_str())) return false;
+    auto doc=BencodeValue::create_dict();doc["version"]=BencodeValue(std::int64_t(1));doc["hash"]=BencodeValue(hash_);
+    std::string encoded;for(int value:p) encoded.push_back(char(value));doc["priorities"]=BencodeValue(encoded);
+    doc["revision"]=BencodeValue(std::int64_t(revision));const auto bytes=doc.encode();
+    auto target=combine_paths(root_,"manifest"),temp=target+".tmp";
+    return create_file_binary(temp.c_str(),bytes.data(),bytes.size()) && replace_file_atomic(temp.c_str(),target.c_str());
+}
+bool BoundaryStore::materialize(std::size_t index,std::vector<std::string>& created) {
+    const auto& file=files_.file_at(index);const auto target=combine_paths(save_,file.path);
+    const bool exists=file_exists(target);
+    if(!create_directories(get_parent_directory(target).c_str())) return false;
+    if(!exists) {if(!create_file_with_size(target,file.size)) return false;created.push_back(target);}
+    if(!file.size) return true;
+    const auto first=std::uint64_t(file.offset)/files_.piece_length(),last=std::uint64_t(file.offset+file.size-1)/files_.piece_length();
+    for(auto p=first;p<=last;++p) {
+        const auto part=part_path(p,index);if(!file_exists(part)) continue;
+        const auto s=full_slice(p,index);Bytes data(s.size);
+        if(get_file_size(part.c_str())!=s.size) continue; // recheck will invalidate missing/truncated bytes
+        if(!read_file_chunk(part,0,data.data(),data.size()) || !write_file_chunk(target,s.offset,data.data(),data.size())) return false;
+    }
+    return true;
+}
+bool BoundaryStore::apply_selection_change(const std::vector<int>& next,std::uint64_t revision) {
+    if(!error_.empty() && !load_manifest()) return false;
+    if(!FileSelection::validate(files_,next).empty()) return false;
+    std::vector<std::string> created;
+    for(std::size_t i=0;i<next.size();++i) if(next[i] && (!priorities_[i] || files_.file_at(i).size==0)) {
+        if(!materialize(i,created)) {for(const auto& path:created) delete_file(path.c_str());return false;}
+    }
+    if(!save_manifest(next,revision)) {for(const auto& path:created) delete_file(path.c_str());return false;}
+    priorities_=next;revision_=revision;
+    const auto wanted=FileSelection::build_piece_priorities(files_,next);
+    // Delete only engine-owned fragments whose numeric identities are known.
+    // Selected data has been materialized before the atomic manifest commit.
+    for(std::uint32_t piece=0;piece<files_.num_pieces();++piece)
+        for(const auto& slice:files_.map_block(piece,0,files_.piece_size(piece)))
+            if(next[slice.file_index] || wanted[piece]==PiecePriority::DontDownload)
+                delete_file(part_path(piece,slice.file_index).c_str());
+    return true;
+}
+}
