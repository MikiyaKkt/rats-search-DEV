+void Client::set_file_priorities(const InfoHash& hash,std::vector<int> priorities,std::uint64_t expected,FileOperationHandler done) {
+    run_on_reactor([&] {
+        auto t=torrents_.find(hash);
+        if(t==torrents_.end()) {done({"taskNotFound","selection","",0,false},0);return;}
+        if(file_operations_.count(hash)) {done({"operationBusy","selection","",0,true},t->second->selection_revision());return;}
+        if(expected!=t->second->selection_revision()) {done({"revisionConflict","selection","",0,false},t->second->selection_revision());return;}
+        if(!t->second->has_metadata() || !FileSelection::validate(t->second->torrent_info().files(),priorities).empty() || expected>=9007199254740991ULL) {
+            done({"invalidSelection","selection","",0,false},expected);return;
+        }
+        file_operations_[hash]=std::move(done);
+        t->second->set_file_priorities(std::move(priorities),expected+1,[this,hash](DiskError error){
+            auto op=file_operations_.find(hash);if(op==file_operations_.end()) return;
+            auto done=std::move(op->second);file_operations_.erase(op);
+            const auto t=torrents_.find(hash);done(error,t==torrents_.end()?0:t->second->selection_revision());
+        });
+    });
+}
+void Client::recheck_torrent(const InfoHash& hash,bool retry,FileOperationHandler done) {
+    run_on_reactor([&] {
+        auto t=torrents_.find(hash);if(t==torrents_.end()) {done({"taskNotFound","recheck","",0,false},0);return;}
+        if(file_operations_.count(hash)) {done({"operationBusy","recheck","",0,true},t->second->selection_revision());return;}
+        file_operations_[hash]=std::move(done);
+        t->second->recheck([this,hash](DiskError error){
+            auto op=file_operations_.find(hash);if(op==file_operations_.end()) return;
+            auto done=std::move(op->second);file_operations_.erase(op);
+            const auto t=torrents_.find(hash);done(error,t==torrents_.end()?0:t->second->selection_revision());
+        },retry);
+    });
+}
 } // namespace librats::bittorrent
