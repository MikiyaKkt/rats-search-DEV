+namespace librats::bittorrent {
+// File indices always refer to the original metadata order, never tree order.
+class FileSelection {
+public:
+    static std::string validate(const FileStorage& files,const std::vector<int>& priorities) {
+        if(priorities.size()!=files.num_files()) return "File priority count does not match metadata";
+        for(int p:priorities) if(p<0 || p>2) return "File priority must be 0, 1 or 2";
+#ifdef _WIN32
+        std::set<std::string> paths;
+        for(std::size_t i=0;i<priorities.size();++i) if(priorities[i]) {
+            auto path=files.file_at(i).path;std::string component;
+            for(std::size_t j=0;j<=path.size();++j) {
+                if(j<path.size() && path[j]!='/') {const unsigned char c=path[j];
+                    if(c<32 || c=='<' || c=='>' || c==':' || c=='"' || c=='\\' || c=='|' || c=='?' || c=='*') return "Invalid Windows file name";
+                    component+=char(c);continue;}
+                if(component.empty() || component.back()=='.' || component.back()==' ') return "Invalid Windows path component";
+                std::string base=component.substr(0,component.find('.'));for(auto& c:base)c=char(std::toupper(static_cast<unsigned char>(c)));
+                if(base=="CON" || base=="PRN" || base=="AUX" || base=="NUL" || (base.size()==4 && (base.substr(0,3)=="COM" || base.substr(0,3)=="LPT") && base[3]>='1' && base[3]<='9'))return "Reserved Windows file name";
+                component.clear();
+            }
+            for(auto& c:path)if(static_cast<unsigned char>(c)<128)c=char(std::tolower(static_cast<unsigned char>(c)));
+            if(!paths.insert(path).second)return "Conflicting Windows file paths";
+        }
+#endif
+        return {};
+    }
+    static std::vector<PiecePriority> build_piece_priorities(const FileStorage& files,const std::vector<int>& priorities) {
+        std::vector<PiecePriority> result(files.num_pieces(),PiecePriority::DontDownload);
+        for(std::size_t i=0;i<priorities.size();++i) {
+            const auto& f=files.file_at(i); if(!priorities[i] || !f.size) continue;
+            const auto first=std::uint64_t(f.offset)/files.piece_length();
+            const auto last=std::uint64_t(f.offset+f.size-1)/files.piece_length();
+            for(auto p=first;p<=last;++p) result[p]=PiecePriority((std::max)(int(result[p]),priorities[i]));
+        }
+        return result;
+    }
+    static std::uint64_t wanted_size(const FileStorage& files,const std::vector<int>& priorities) {
+        std::uint64_t n=0;for(std::size_t i=0;i<priorities.size();++i) if(priorities[i]) n+=files.file_at(i).size;return n;
+    }
+    static std::uint64_t wanted_verified(const std::vector<std::uint64_t>& verified,const std::vector<int>& priorities) {
+        std::uint64_t n=0;for(std::size_t i=0;i<priorities.size() && i<verified.size();++i) if(priorities[i]) n+=verified[i];return n;
+    }
+    static bool any_selected(const std::vector<int>& priorities) {return std::any_of(priorities.begin(),priorities.end(),[](int p){return p!=0;});}
+};
+}
