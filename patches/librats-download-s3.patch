diff --git a/src/librats/bittorrent/disk_cache_budget.h b/src/librats/bittorrent/disk_cache_budget.h
new file mode 100644
index 0000000..63809c9
--- /dev/null
+++ b/src/librats/bittorrent/disk_cache_budget.h
@@ -0,0 +1,41 @@
+#pragma once
+#include "librats/core/bytes.h"
+#include <list>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <atomic>
+
+namespace librats::bittorrent {
+// Shared across a Client. Only immutable completed read payloads are retained.
+// In-flight write buffers remain governed separately by the existing backpressure.
+class DiskCacheBudget {
+public:
+    explicit DiskCacheBudget(std::size_t limit=0):limit_(limit),enabled_(limit!=0){}
+    bool enabled() const {return enabled_.load(std::memory_order_relaxed);}
+    void set_limit(std::size_t limit) {std::lock_guard<std::mutex> lock(mutex_);limit_=limit;enabled_=limit!=0;evict();}
+    std::size_t used() const {std::lock_guard<std::mutex> lock(mutex_);return used_;}
+    bool acquire(const std::string& key,Bytes& out,std::uint64_t& generation) {
+        std::lock_guard<std::mutex> lock(mutex_);generation=generation_;auto it=items_.find(key);if(it==items_.end())return false;
+        lru_.splice(lru_.begin(),lru_,it->second.position);out=it->second.bytes;return true;
+    }
+    void release(const std::string& key,Bytes bytes,std::uint64_t generation) {
+        std::lock_guard<std::mutex> lock(mutex_);if(generation!=generation_ || bytes.size()>limit_ || limit_==0)return;
+        auto it=items_.find(key);if(it!=items_.end()){used_-=it->second.bytes.size();lru_.erase(it->second.position);items_.erase(it);}
+        // Evict before insertion so retained bytes never exceed the hard budget.
+        while(!lru_.empty() && (used_>limit_-bytes.size() || items_.size()>=4096))erase_oldest();
+        lru_.push_front(key);used_+=bytes.size();items_.emplace(key,Entry{std::move(bytes),lru_.begin()});
+    }
+    void invalidate() {std::lock_guard<std::mutex> lock(mutex_);++generation_;items_.clear();lru_.clear();used_=0;}
+private:
+    struct Entry {Bytes bytes;std::list<std::string>::iterator position;};
+    void erase_oldest(){auto it=items_.find(lru_.back());used_-=it->second.bytes.size();items_.erase(it);lru_.pop_back();}
+    void evict(){while(used_>limit_ && !lru_.empty())erase_oldest();}
+    mutable std::mutex mutex_;
+    std::size_t limit_=0,used_=0;
+    std::atomic<bool> enabled_{false};
+    std::uint64_t generation_=0;
+    std::list<std::string> lru_;
+    std::unordered_map<std::string,Entry> items_;
+};
+}
