+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace librats::bittorrent {
+enum class DownloadStrategy {RarestFirst,Sequential,FirstLast};
+struct RequestWindowPolicy {
+    bool automatic=true;
+    int manual=32,minimum=2,maximum=32;
+    bool valid() const {return manual>=1 && manual<=128 && minimum>=1 && minimum<=maximum && maximum<=128;}
+    int computeWindow(double bytesPerSecond,double rttMs,std::size_t queuedBytes=0) const {
+        if(!valid())return 1;
+        if(queuedBytes>4*1024*1024)return 0;
+        if(!automatic)return manual;
+        if(!std::isfinite(bytesPerSecond) || !std::isfinite(rttMs) || bytesPerSecond<=0 || rttMs<=0)return (std::clamp)(32,minimum,maximum);
+        const auto target=std::ceil(bytesPerSecond*(std::max)(50.0,rttMs)/1000.0*2/16384.0);
+        return int((std::clamp)(target,double(minimum),double(maximum)));
+    }
+};
+struct PieceRange {std::uint32_t begin=0,end=0,verified=0,wanted=0,active=0,high=0;};
+}
