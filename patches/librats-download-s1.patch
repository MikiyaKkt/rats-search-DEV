+#pragma once
+#include "librats/bittorrent/rate_limiter.h"
+#include "librats/bittorrent/types.h"
+#include <chrono>
+#include <map>
+
+namespace librats::bittorrent {
+class BandwidthController {
+public:
+    struct Policy { std::uint64_t down = 0, up = 0; };
+    static std::int64_t now() {
+        return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+    void set_global_policy(Policy p) { global_ = p; down_.configure(p.down, now()); request_.configure(p.down,now()); up_.configure(p.up, now()); refresh_shares(); }
+    void set_task_policy(const InfoHash& h, Policy p) {
+        auto& t = tasks_[h]; t.policy = p;
+        t.down.configure(p.down, now()); t.up.configure(p.up, now());
+        t.request.configure(p.down,now());
+    }
+    void set_active(const InfoHash& h, bool active, bool downloading=true) {
+        auto& t = tasks_[h];
+        if (t.active == active && t.downloading==downloading) return;
+        t.active = active; t.downloading=downloading; refresh_shares();
+    }
+    void remove_task(const InfoHash& h) { auto t=tasks_.find(h); if(t!=tasks_.end()) inflight_-=t->second.inflight; tasks_.erase(h); refresh_shares(); }
+    std::size_t available(const InfoHash& h, bool upload, bool content, std::size_t wanted) {
+        auto n = now();
+        if (!content) {
+            control_.configure(65536, n);
+            return (std::min<std::uint64_t>)(wanted, control_.available(n));
+        }
+        auto& t = tasks_[h];
+        auto& own = upload ? t.up : t.down;
+        auto& share = upload ? t.shareUp : t.shareDown;
+        auto& all = upload ? up_ : down_;
+        return (std::min<std::uint64_t>)(wanted,
+            (std::min)(all.available(n), (std::min)(own.available(n), share.available(n))));
+    }
+    void commit(const InfoHash& h, bool upload, bool content, std::size_t bytes) {
+        const auto n = now();
+        if (!content) { control_.consume(bytes, n); return; }
+        auto& t = tasks_[h];
+        (upload ? up_ : down_).consume(bytes, n);
+        (upload ? t.up : t.down).consume(bytes, n);
+        (upload ? t.shareUp : t.shareDown).consume(bytes, n);
+        if (upload) t.sent += bytes; else t.received += bytes;
+    }
+    std::uint64_t sent(const InfoHash& h) const { auto i = tasks_.find(h); return i == tasks_.end() ? 0 : i->second.sent; }
+    std::uint64_t received(const InfoHash& h) const { auto i = tasks_.find(h); return i == tasks_.end() ? 0 : i->second.received; }
+    std::chrono::milliseconds delay(const InfoHash& h, bool upload, bool content) {
+        auto n = now(); auto ready = n;
+        if (!content) ready = control_.nextReadyAt(1, n);
+        else {
+            auto& t = tasks_[h];
+            ready = (std::max)({(upload ? up_ : down_).nextReadyAt(1,n),
+                (upload ? t.up : t.down).nextReadyAt(1,n), (upload ? t.shareUp : t.shareDown).nextReadyAt(1,n)});
+        }
+        return std::chrono::milliseconds((std::max<std::int64_t>)(1, ready-n));
+    }
+    // In-flight reservations bound content request memory independently from
+    // ingress tokens. No token refund on CANCEL: late responses remain charged.
+    bool reserve_download(const InfoHash& h, std::size_t bytes) {
+        auto& t = tasks_[h];
+        if (inflight_ + bytes > 32*1024*1024 || t.inflight + bytes > 512*1024) return false;
+        const auto n=now();
+        if((std::min)({request_.available(n),t.request.available(n),t.requestShare.available(n)})<bytes) return false;
+        request_.consume(bytes,n);t.request.consume(bytes,n);t.requestShare.consume(bytes,n);
+        inflight_ += bytes; t.inflight += bytes; return true;
+    }
+    std::chrono::milliseconds request_delay(const InfoHash& h,std::size_t bytes) {
+        auto& t=tasks_[h]; const auto n=now();
+        if(inflight_+bytes>32*1024*1024 || t.inflight+bytes>512*1024) return std::chrono::milliseconds(1000);
+        const auto ready=(std::max)({request_.nextReadyAt(bytes,n),t.request.nextReadyAt(bytes,n),t.requestShare.nextReadyAt(bytes,n)});
+        return std::chrono::milliseconds((std::max<std::int64_t>)(1,ready-n));
+    }
+    void release_reservation(const InfoHash& h, std::size_t bytes) {
+        auto& t = tasks_[h]; auto n = (std::min)(bytes,t.inflight); t.inflight -= n; inflight_ -= n;
+    }
+private:
+    struct Task { Policy policy; TokenBucket down,up,shareDown,shareUp,request,requestShare; bool active=false,downloading=false; std::uint64_t sent=0,received=0; std::size_t inflight=0; };
+    void refresh_shares() {
+        std::size_t count=0, downloadCount=0; for (const auto& [h,t] : tasks_) if(t.active) { ++count; if(t.downloading) ++downloadCount; }
+        count = (std::max<std::size_t>)(count,1);
+        downloadCount=(std::max<std::size_t>)(downloadCount,1);
+        for (auto& [h,t] : tasks_) {
+            t.shareDown.configure(global_.down ? (long double)global_.down/downloadCount : 0,now());
+            t.requestShare.configure(global_.down ? (long double)global_.down/downloadCount : 0,now());
+            t.shareUp.configure(global_.up ? (long double)global_.up/count : 0,now());
+        }
+    }
+    Policy global_; TokenBucket down_,up_,control_,request_;
+    std::map<InfoHash,Task> tasks_;
+    std::size_t inflight_=0;
+};
+}
