+bool Client::can_connect(const InfoHash* hash) const {
+    std::size_t total=pending_connects_.size(), task=0;
+    for(const auto& pc:connections_) if(!pc->closed()) { ++total; if(hash && pc->info_hash()==*hash) ++task; }
+    if(total>=max_connections_) return false;
+    if(!hash) return true;
+    for(const auto& [s,h]:pending_hashes_) if(h==*hash) ++task;
+    const auto i=task_limits_.find(*hash);
+    return task < (i==task_limits_.end()?task_connections_:i->second);
+}
+
+void Client::enforce_connections() {
+    std::map<InfoHash,std::size_t> counts;
+    std::size_t total=0;
+    for(auto& pc:connections_) if(!pc->closed()) {
+        const auto h=pc->info_hash();
+        auto limit=task_limits_.count(h)?task_limits_.at(h):task_connections_;
+        if(total>=max_connections_ || counts[h]>=limit) pc->close("connection policy reduced");
+        else { ++total; ++counts[h]; }
+    }
+    std::vector<socket_t> rejected;
+    for(const auto& [s,h]:pending_hashes_) {
+        const auto limit=task_limits_.count(h)?task_limits_.at(h):task_connections_;
+        if(total>=max_connections_ || counts[h]>=limit) rejected.push_back(s);
+        else { ++total; ++counts[h]; }
+    }
+    for(auto s:rejected) {
+        const auto h=pending_hashes_.at(s);
+        const auto endpoint=pending_endpoints_.at(s);
+        reactor_.cancel(pending_connects_.at(s)); reactor_.remove(s); close_socket(s);
+        pending_connects_.erase(s); pending_hashes_.erase(s);
+        pending_endpoints_.erase(s);
+        auto t=torrents_.find(h);
+        if(t!=torrents_.end()) t->second->on_connect_failed(endpoint.first,endpoint.second);
+    }
+}
+
+void Client::set_global_policy(BandwidthController::Policy p, std::size_t peers, std::size_t taskPeers, std::size_t checking) {
+    run_on_reactor([&] {
+        bandwidth_.set_global_policy(p);
+        max_connections_=(std::max<std::size_t>)(1,peers); task_connections_=(std::max<std::size_t>)(1,taskPeers);
+        checking_limit_=(std::max<std::size_t>)(1,checking);
+        enforce_connections();
+        wake_bandwidth_waiters();
+    });
+}
+bool Client::set_task_policy(const InfoHash& hash, BandwidthController::Policy p, std::size_t peers) {
+    return run_on_reactor([&] {
+        if(!torrents_.count(hash)) return false;
+        bandwidth_.set_task_policy(hash,p); task_limits_[hash]=(std::max<std::size_t>)(1,peers);
+        enforce_connections(); wake_bandwidth_waiters(); return true;
+    });
+}
+bool Client::allow_content(const InfoHash& hash, bool allowed) {
+    return run_on_reactor([&] { auto t=torrents_.find(hash); if(t==torrents_.end()) return false;
+        t->second->set_content_allowed(allowed); return true; });
+}
+std::shared_ptr<void> Client::acquire_check_slot() {
+    if(*active_checks_>=checking_limit_) return {};
+    ++*active_checks_;
+    return std::shared_ptr<void>(new int(0),[count=active_checks_](void* p){ delete static_cast<int*>(p); --*count; });
+}
+void Client::wake_bandwidth_waiters() {
+    std::vector<PeerConnection*> peers;
+    for(const auto& pc:connections_) if(!pc->closed()) peers.push_back(pc.get());
+    for(auto* peer:peers) peer->on_budget_ready();
+    for(auto& [h,t]:torrents_) t->wake_bandwidth();
+}
 } // namespace librats::bittorrent
