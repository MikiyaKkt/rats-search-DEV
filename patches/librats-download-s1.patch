+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <limits>
+
+namespace librats::bittorrent {
+// Reactor-owned bucket, time supplied by caller for deterministic tests.
+// Limited buckets start empty. Capacity is public: max(16KiB, min(R/10,1MiB)).
+class TokenBucket {
+public:
+    bool configure(long double rate, std::int64_t now) {
+        if(!std::isfinite(rate) || rate<0 || rate>9007199254740991.0L) return false;
+        refill(now);
+        if (rate == rate_) return true;
+        rate_ = rate;
+        capacity_ = std::uint64_t((std::max<long double>)(16384, (std::min<long double>)(rate / 10, 1048576)));
+        tokens_ = 0;
+        last_ = now;
+        return true;
+    }
+    void refill(std::int64_t now) {
+        if (last_ < 0 || now < last_) { last_ = now; tokens_ = 0; return; }
+        if (rate_) tokens_ = (std::min<long double>)(capacity_, tokens_ + (long double)(now-last_) * rate_ / 1000);
+        last_ = now;
+    }
+    std::uint64_t available(std::int64_t now) {
+        refill(now);
+        return rate_ ? std::uint64_t(tokens_) : (std::numeric_limits<std::uint64_t>::max)();
+    }
+    bool consume(std::uint64_t bytes, std::int64_t now) {
+        if (available(now) < bytes) return false;
+        if (rate_) tokens_ -= bytes;
+        return true;
+    }
+    std::int64_t nextReadyAt(std::uint64_t bytes, std::int64_t now) {
+        const auto have = available(now);
+        if (have >= bytes) return now;
+        const auto wait=std::ceil((long double)(bytes-have)*1000/rate_);
+        const auto maximum=(std::numeric_limits<std::int64_t>::max)();
+        if(wait>(long double)maximum-now) return maximum;
+        return now + std::int64_t(wait);
+    }
+    std::uint64_t capacity() const { return capacity_; }
+private:
+    long double rate_ = 0;
+    std::uint64_t capacity_ = 16384;
+    long double tokens_ = 0;
+    std::int64_t last_ = -1;
+};
+}
