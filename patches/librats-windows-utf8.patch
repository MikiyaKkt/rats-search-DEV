+TEST_F(BtDiskIo, Utf8SavePathAndTorrentNamesSurviveReopen) {
+    const std::string save_path = stdfs::path(dir_).u8string() + u8"/\u4e0b\u8f7d\U0001f4e6";
+    const std::string root = u8"\u6d4b\u8bd5";
+    const std::string name = u8"\u65e5\u672c\u8a9e.bin";
+    const Bytes data = make_data(35000);
+    const TorrentInfo info = multi_file_info(root, {{name, 35000}}, data, 16384);
+    {
+        ThreadedDiskIo disk(info, save_path, {}, {2});
+        ASSERT_NO_FATAL_FAILURE(write_all(disk, info, data));
+    }
+    const auto native = stdfs::u8path(save_path + "/" + root + "/" + name);
+    ASSERT_TRUE(stdfs::is_regular_file(native));
+    EXPECT_EQ(stdfs::file_size(native), data.size());
+    std::ifstream file(native, std::ios::binary);
+    const std::string stored((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+    EXPECT_EQ(stored, std::string(data.begin(), data.end()));
+
+    // Reopening must find and verify the same files (the resume/recheck path).
+    ThreadedDiskIo reopened(info, save_path, {}, {2});
+    std::promise<Bitfield> checked;
+    reopened.async_check_files(Bitfield{}, nullptr, [&](Bitfield have) { checked.set_value(std::move(have)); });
+    EXPECT_EQ(checked.get_future().get().count(), info.num_pieces());
+}
